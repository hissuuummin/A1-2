# ==============================================================================
# Domestic Travel Planner API 환경변수 설정 템플릿
# ==============================================================================
# 실제 API 키를 입력할 때는 이 파일을 복사하여 '.env' 파일로 저장하세요.
# 주의: .env 파일은 절대 Git에 커밋하거나 외부에 공유하지 마세요 (.gitignore 등록됨).

# ------------------------------------------------------------------------------
# 1. LLM API 제공자 선택 (Gemini 또는 OpenAI 중 최소 1개 필수)
# ------------------------------------------------------------------------------
# Google Gemini API Key (무료 발급: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (발급: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. 지도 / 장소 검색 API 제공자 선택 (Kakao 또는 Naver 중 최소 1개 필수)
# ------------------------------------------------------------------------------
# Kakao Local REST API Key (발급: https://developers.kakao.com/ -> 내 애플리케이션 -> REST API 키)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Naver Search API (발급: https://developers.naver.com/ -> 애플리케이션 등록 -> 검색)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
